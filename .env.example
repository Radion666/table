# ============================================
# Timesheet App - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values

# Frontend - API URL (relative path works through nginx proxy)
# Change to http://YOUR_SERVER_IP/api/v1 if accessing from outside
VITE_API_URL=/api/v1

# Backend port (external)
BACKEND_PORT=42131

# PostgreSQL
PG_USERNAME=timesheet_user
PG_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
PG_DATABASE=timesheet_db
PG_HOST=postgres
PG_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@timesheet.local
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# JWT Secret (IMPORTANT: generate a random 64+ char string!)
PRIVATE_KEY=CHANGE_ME_TO_RANDOM_JWT_SECRET

# Telegram notifications (optional - leave empty if not needed)
TG_API_TOKEN=
TG_CHAT_ID=